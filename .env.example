DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/doctor_hunt?schema=public"

# Better Auth — required for sign-in / booking
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: only if the browser uses a different origin than the app (defaults to same-origin /api/auth)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# After you sign up, set this to your email and run: npm run db:seed — grants admin (admin panel access)
# ADMIN_EMAIL="you@example.com"
